{
    "name": "recent-tabs",
    "version": "1.6.1",
    "description": "Fast switch between tabs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sergcen/recent-tabs.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/sergcen/recent-tabs/issues"
    },
    "homepage": "https://github.com/sergcen/recent-tabs#readme",
    "dependencies": {
        "convert-layout": "0.11.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "webextension-polyfill": "0.12.0"
    },
    "scripts": {
        "dev": "webextension-toolbox dev chrome --src src --config webextension-toolbox-config.js",
        "build": "npm run build:chrome",
        "build:chrome": "webextension-toolbox build chrome --src src --config webextension-toolbox-config.js --devtool false",
        "build:firefox": "webextension-toolbox build firefox --src src --config webextension-toolbox-config.js --devtool false",
        "test": "jest"
    },
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@babel/preset-env": "7.29.7",
        "@babel/preset-react": "7.29.7",
        "@webextension-toolbox/webextension-toolbox": "7.1.1",
        "babel-loader": "10.1.1",
        "css-loader": "7.1.5",
        "jest": "30.5.0",
        "prettier": "3.9.6",
        "sass": "1.103.1",
        "sass-loader": "17.0.1",
        "style-loader": "4.0.0",
        "webpack": "5.110.2"
    },
    "engines": {
        "node": ">=22.11.0 <26"
    },
    "prettier": {
        "singleQuote": true,
        "tabWidth": 4
    },
    "overrides": {
        "webpackbar": "7.0.0"
    }
}
